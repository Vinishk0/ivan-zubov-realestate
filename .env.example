# Community token with permission to send messages. Server only.
VK_COMMUNITY_TOKEN=
# Ivan's numeric user ID, or the conversation peer ID.
VK_PEER_ID=
VK_RECIPIENT_DOMAIN=prostozubov
# Local / Preview: true sends ONLY to the test recipient, never to Ivan.
# Production: false sends to VK_PEER_ID or VK_RECIPIENT_DOMAIN above.
VK_TEST_MODE=true
VK_TEST_COPY_TO_OWNER=false
VK_TEST_PEER_ID=
VK_TEST_RECIPIENT_DOMAIN=vinishk0o0
# Optional exact site origin, e.g. https://example.ru
LEAD_ALLOWED_ORIGIN=

# Reviews: Upstash-compatible Redis REST endpoint (server-only).
REVIEWS_REDIS_URL=
REVIEWS_REDIS_TOKEN=
REVIEWS_NAMESPACE=ivan-reviews
# Numeric VK community ID and authorized moderator user IDs, comma-separated.
VK_GROUP_ID=
VK_REVIEW_MODERATOR_IDS=
VK_CALLBACK_SECRET=
VK_CALLBACK_CONFIRMATION=
